[MASTER]
load-plugins=pylint_odoo
score=n

[ODOO-LINT]
manifest-required-keys=license
valid-odoo-versions=16.0

[MESSAGES CONTROL]
disable=all
enable=odoo-addons-relative-import,missing-import-error,manifest-required-key,manifest-version-format,no-utf8-coding-comment,development-status-allowed,sql-injection,translation-required,use-vim-comment
