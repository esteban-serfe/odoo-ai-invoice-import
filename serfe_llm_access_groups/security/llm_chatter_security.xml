<?xml version="1.0" encoding="utf-8" ?>
<!--
"User: LLM Chatter" group: the only non-manager group allowed to use the AI
chat (apx_llm_thread: the "AI" button in every record's chatter, the Chat menu and
the llm.thread model). The vendored apx_llm_thread module grants all of that to
base.group_user, so any internal user could chat with the LLM. Patches the
existing records by external ID (plain <record> tags, same reason as
llm_menu_security.xml) instead of editing the vendored module. LLM Manager
implies this group, so managers and Settings/Admin keep access.
-->
<odoo>
    <record id="group_llm_chatter_user" model="res.groups">
        <field name="name">User: LLM Chatter</field>
        <field name="category_id" ref="apx_llm.module_category_llm" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="apx_llm.group_llm_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_llm_chatter_user'))]" />
    </record>

    <!-- llm.thread: ACL and personal-threads rule move from every internal user to this group -->
    <record id="apx_llm_thread.access_llm_thread_user" model="ir.model.access">
        <field name="group_id" ref="group_llm_chatter_user" />
    </record>
    <record id="apx_llm_thread.llm_thread_rule_personal" model="ir.rule">
        <field name="groups" eval="[(6, 0, [ref('group_llm_chatter_user')])]" />
    </record>

    <!-- Chat menu: previously open to every internal user -->
    <record id="apx_llm_thread.menu_llm_chat" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_llm_chatter_user'))]" />
    </record>
</odoo>
